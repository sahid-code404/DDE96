{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Glasswave Design Tokens",
  "version": "1.0.0",
  "colors": {
    "accents": {
      "blue": { "light": "#007AFF", "dark": "#0A84FF" },
      "purple": { "light": "#5856D6", "dark": "#5E5CE6" },
      "pink": { "light": "#FF2D55", "dark": "#FF375F" },
      "orange": { "light": "#FF9500", "dark": "#FF9F0A" },
      "green": { "light": "#34C759", "dark": "#30D158" },
      "graphite": { "light": "#8E8E93", "dark": "#98989D" }
    },
    "traffic_lights": {
      "close": "#FF5F56",
      "minimize": "#FFBD2E",
      "maximize": "#27C93F"
    },
    "surfaces": {
      "light": {
        "panel": "rgba(255, 255, 255, 0.75)",
        "popover": "rgba(255, 255, 255, 0.85)",
        "modal": "rgba(255, 255, 255, 0.94)",
        "card": "rgba(255, 255, 255, 0.70)",
        "background_fallback": "#F5F5F7",
        "border": "rgba(0, 0, 0, 0.10)",
        "text_primary": "#1C1C1E",
        "text_secondary": "#636366",
        "text_tertiary": "#8E8E93"
      },
      "dark": {
        "panel": "rgba(28, 28, 30, 0.78)",
        "popover": "rgba(44, 44, 46, 0.85)",
        "modal": "rgba(30, 30, 32, 0.94)",
        "card": "rgba(44, 44, 46, 0.65)",
        "background_fallback": "#1C1C1E",
        "border": "rgba(255, 255, 255, 0.12)",
        "text_primary": "#FFFFFF",
        "text_secondary": "#AEAEB2",
        "text_tertiary": "#636366"
      }
    }
  },
  "radii": {
    "small": 6,
    "medium": 10,
    "large": 16,
    "extra_large": 22,
    "dock": 24,
    "squircle_percentage": 22.5
  },
  "elevation_shadows": {
    "level_1": "0 2px 8px rgba(0, 0, 0, 0.12)",
    "level_2": "0 4px 16px rgba(0, 0, 0, 0.18)",
    "level_3": "0 12px 32px rgba(0, 0, 0, 0.28)",
    "level_4": "0 24px 64px rgba(0, 0, 0, 0.40)"
  },
  "typography": {
    "font_family_sans": "Inter, 'SF Pro Display', Cantarell, sans-serif",
    "font_family_mono": "'SF Mono', 'JetBrains Mono', Hack, monospace",
    "scale": {
      "caption": { "size": 11, "line_height": 1.35, "weight": "normal" },
      "body": { "size": 13, "line_height": 1.4, "weight": "normal" },
      "title_2": { "size": 15, "line_height": 1.3, "weight": "500" },
      "title_1": { "size": 18, "line_height": 1.25, "weight": "600" },
      "display": { "size": 24, "line_height": 1.2, "weight": "bold" }
    }
  },
  "motion": {
    "easing_standard": "cubic-bezier(0.25, 0.1, 0.25, 1.0)",
    "easing_spring": "cubic-bezier(0.34, 1.56, 0.64, 1.0)",
    "duration_fast_ms": 120,
    "duration_normal_ms": 200,
    "duration_slow_ms": 280,
    "reduced_motion_duration_ms": 0
  }
}
